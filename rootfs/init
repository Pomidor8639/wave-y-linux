#!/bin/sh

# Mount virtual filesystems
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

# Ensure essential device nodes exist
mknod -m 600 /dev/console c 5 1 2>/dev/null || true
mknod -m 666 /dev/null c 1 3 2>/dev/null || true
mknod -m 666 /dev/zero c 1 5 2>/dev/null || true
mknod -m 666 /dev/tty c 5 0 2>/dev/null || true
mknod -m 620 /dev/tty0 c 4 0 2>/dev/null || true
mknod -m 620 /dev/tty1 c 4 1 2>/dev/null || true
mknod -m 660 /dev/ttyS0 c 4 64 2>/dev/null || true
mknod -m 660 /dev/fb0 c 29 0 2>/dev/null || true

# Ensure LCD backlight and framebuffer are unblanked
echo 0 > /sys/class/graphics/fb0/blank 2>/dev/null || true
echo 255 > /sys/class/backlight/totoro_bl/brightness 2>/dev/null || true

# Set up hostname
hostname wave-y

# Clear screen and display banner on LCD screen (tty0) and UART (ttyS0)
clear > /dev/tty0 2>/dev/null || true
for term in /dev/tty0 /dev/ttyS0 /dev/console; do
    if [ -e "$term" ]; then
        echo "=======================================================" > "$term" 2>/dev/null || true
        echo "   WELCOME TO LINUX ON SAMSUNG WAVE Y (GT-S5380)       " > "$term" 2>/dev/null || true
        echo "   SoC: Broadcom BCM21553 (ARMv6 @ 832 MHz)           " > "$term" 2>/dev/null || true
        echo "   Kernel: Linux 2.6.35.7 (Tux on LCD Framebuffer!)   " > "$term" 2>/dev/null || true
        echo "=======================================================" > "$term" 2>/dev/null || true
        echo "" > "$term" 2>/dev/null || true
    fi
done

# Enable USB Gadget for PC connection
if [ -d /sys/class/android_usb/android0 ]; then
    echo 0 > /sys/class/android_usb/android0/enable 2>/dev/null || true
    echo 04e8 > /sys/class/android_usb/android0/idVendor 2>/dev/null || true
    echo 685e > /sys/class/android_usb/android0/idProduct 2>/dev/null || true
    echo "adb,acm" > /sys/class/android_usb/android0/functions 2>/dev/null || true
    echo 1 > /sys/class/android_usb/android0/enable 2>/dev/null || true
fi

# Spawn interactive shell
while true; do
    if [ -e /dev/tty0 ]; then
        /bin/sh </dev/tty0 >/dev/tty0 2>&1
    elif [ -e /dev/ttyS0 ]; then
        /bin/sh </dev/ttyS0 >/dev/ttyS0 2>&1
    else
        /bin/sh
    fi
    sleep 1
done

